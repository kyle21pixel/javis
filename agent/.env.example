# ── Server ────────────────────────────────────────
PORT=8000

# ── Business Identity ─────────────────────────────
BUSINESS_NAME=My Business
BUSINESS_TYPE=general retail
OWNER_NAME=Kyle

# ── Google Gemini AI ──────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash

# ── Auto-send replies (true = send immediately) ───
AUTO_SEND_REPLIES=false

# ── Gmail (use an App Password, not your real pw) ─
EMAIL_ADDRESS=you@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_POLL_SECS=30

# ── SMS Provider: "twilio" or "africastalking" ────
SMS_PROVIDER=twilio

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Africa's Talking (East Africa)
AT_API_KEY=your_at_api_key
AT_USERNAME=your_at_username
AT_SENDER_ID=JAVIS

# ── Database ──────────────────────────────────────
DATABASE_PATH=javis.db
DATABASE_URL=sqlite:///javis.db

# ── Redis cache / rate limiting ─────────────────────
REDIS_URL=redis://localhost:6379/0
ENABLE_REDIS_CACHE=false
RATE_LIMIT_WINDOW_SECS=60
RATE_LIMIT_MAX_REQUESTS=120

# ── Retry settings ─────────────────────────────────
SEND_RETRY_COUNT=3
SEND_RETRY_BACKOFF=2

# ── Auth / Admin ───────────────────────────────────
JWT_SECRET=replace-me-with-a-secure-random-string
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin123

# ── C Queue Dispatcher (internal) ────────────────
DISPATCHER_HOST=127.0.0.1
DISPATCHER_PORT=9000
